# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Node dependency trees. The channel sidecars install theirs in place the
# first time a server boots from a checkout, and ui/ has its own — together
# they add gigabytes to the build context for files no stage reads (the
# image installs the wheel, then runs `npm ci` from the lockfile itself).
# The `**/` prefix is required: a bare ``node_modules/`` would only match
# the one at the context root and miss every nested tree.
**/node_modules/

# Built UI output. ``ui/release/`` is the Electron installer tree — gitignored,
# and on a developer's machine ~2 GB of .exe/.dmg/.AppImage that no stage reads
# (the image installs the wheel, which carries the prebuilt SPA). Without these
# the build context is ~2.0 GB instead of ~100 MB.
ui/release/
ui/dist/
ui/dist-web/
ui/dist-electron/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
# README.md is referenced by pyproject.toml's ``readme`` field; hatchling
# reads it during editable installs (--channel dev --mode docker), so
# keep it in the build context even though we ignore other markdown.
!README.md
# Bundled system docs that ``cremind serve`` seeds into
# <CREMIND_SYSTEM_DIR>/documents on boot (app/server.py ->
# DocumentSyncService.seed_shared_from_app). Production images get these
# via the wheel, but the ``-e /src`` dev image installs from this build
# context, so they must survive the ``*.md`` exclusion above.
!app/documents/bundled/**
docs/

# Tests
tests/
pytest.ini
.pytest_cache/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# Misc
.DS_Store
*.log
# Ignore patterns are matched against the context-root-relative path, so the
# rule above catches only root-level logs — the server's log directory needs
# naming outright.
logs/

.playwright-mcp/

cli/cremind
cli/cremind.exe