# Cremind Docker bundle.
#
# Four services defined; only ``cremind`` is started unconditionally —
# the Setup Wizard activates the rest by appending their profile to
# ``COMPOSE_PROFILES`` in the sibling ``.env`` and running
# ``docker compose up -d`` from within the cremind container (via the
# mounted Docker socket).
#
#   cremind    The Cremind agent + the SPA static server. On the desktop
#             image (cremind/cremind-desktop) it also runs an XFCE desktop
#             + VNC so the agent can drive a real GUI, observable at
#             http://<host>:6080/vnc.html. On the basic image
#             (cremind/cremind) there is no desktop and the installer
#             strips the noVNC/VNC port maps + VNC env below. Always started.
#   postgres  Application database. Gated by ``with-postgres``;
#             activated when the wizard picks Database = Postgres / Docker.
#   qdrant    Vector store. Gated by ``with-qdrant``; activated when
#             the wizard picks Vector Store = Qdrant / Docker.
#   chroma   Vector store. Gated by ``with-chroma``; activated when the
#             wizard picks Vector Store = ChromaDB / Docker.
#
# Compose project name is pinned via ``COMPOSE_PROJECT_NAME=cremind`` in
# ``.env`` so the project name stays consistent whether docker compose
# is invoked from the host or from inside the cremind container — the
# named volumes (cremind-data, pg-data, …) only line up when the
# project name matches.

services:
  cremind:
    # Pre-built image pulled from Docker Hub. Release CI pushes both flavors
    # (``cremind/cremind-desktop:<version>`` and ``cremind/cremind:<version>``,
    # plus ``:latest`` on prod). ``CREMIND_IMAGE`` selects the flavor and is
    # written into ``.env`` by install.sh / install.ps1 from the desktop-UI
    # answer; the ``:-`` default keeps a pre-flavor ``.env`` (which lacks the
    # key) on the desktop image. ``CREMIND_VERSION`` is resolved at install
    # time against PyPI (production) or Test PyPI (test). The dev channel
    # re-adds a ``build:`` section via docker-compose.override.yml so it can
    # build from a local checkout instead of pulling.
    image: ${CREMIND_IMAGE:-cremind/cremind-desktop}:${CREMIND_VERSION}
    ports:
      # Single public port: the merged app serves UI + API + A2A + OAuth
      # same-origin on 1515. The internal API bind (1112) is loopback-only
      # inside the container and is deliberately NOT published.
      - "${SPA_PORT:-1515}:1515"
      # Callback port for "Sign in with ChatGPT" (Codex OAuth). OpenAI's
      # redirect URI is hard-coded to http://localhost:1455/auth/callback and
      # cannot be configured, so the browser can only hand the authorization
      # code to Cremind if that exact host port reaches the container. Bound to
      # 127.0.0.1 on the host: it is a short-lived loopback callback, never
      # something to expose beyond this machine. If you need host port 1455 for
      # something else (e.g. a host-side `codex` CLI login), set
      # CODEX_CALLBACK_PORT to a free port in .env — sign-in then falls back to
      # pasting the redirect URL, which always works.
      - "127.0.0.1:${CODEX_CALLBACK_PORT:-1455}:1455"
      # >>> desktop-only >>>
      - "${NOVNC_PORT:-6080}:80"
      - "${VNC_PORT:-5900}:5900"
      # <<< desktop-only <<<
    environment:
      ENV: production
      HOST: 0.0.0.0
      PORT: 1112
      APP_URL: ${APP_URL}
      DEBUG: "false"
      LOG_LEVEL: INFO
      DISABLE_LOG: "false"
      CORS_ALLOWED_ORIGINS: ${CORS_ALLOWED_ORIGINS}
      SETUP_WIZARD_ENV: ${SETUP_WIZARD_ENV:-local}
      # HTTPS on 1515, which also turns it into an HTTP/2 origin. Empty by
      # default, which keeps the port plain HTTP. Set these in .env — the
      # cert/key paths are container-side, so uncomment the certs mount in
      # ``volumes:`` below first. ``CREMIND_SSL=auto`` needs no mount: it
      # generates into /root/.cremind/tls (the cremind-data volume). Devices
      # trust that CA once — fetch it from the running server at <origin>/ca.pem
      # (or ``docker compose exec cremind cremind tls export --out -``).
      # ``CREMIND_SSL=after-setup`` is the same generated CA with the switch
      # deferred by one phase: plain HTTP while the Setup Wizard runs, so the
      # wizard can walk the user through trusting the CA before any https page
      # exists, then a container restart into https — the first https load is
      # to an already-trusting browser, so no warning is ever shown. APP_URL
      # stays the https:// steady state either way.
      CREMIND_SSL_CERTFILE: ${CREMIND_SSL_CERTFILE:-}
      CREMIND_SSL_KEYFILE: ${CREMIND_SSL_KEYFILE:-}
      CREMIND_SSL_KEYFILE_PASSWORD: ${CREMIND_SSL_KEYFILE_PASSWORD:-}
      CREMIND_SSL: ${CREMIND_SSL:-}
      CREMIND_SSL_AUTO_HOSTS: ${CREMIND_SSL_AUTO_HOSTS:-}
      # How Cremind was installed. Read by the backend's service-mode
      # filter (see install_catalog.toml's [mode_rules]) so the Setup
      # Wizard only offers per-service modes that match the install.
      INSTALL_MODE: ${INSTALL_MODE:-docker}
      # Release channel — the installer writes this into the sibling
      # ``.env`` (production / test / dev). The container's feature
      # installer reads it via ``app.upgrade.channel.get_channel()`` and
      # uses it to pick ``pip_spec()`` behavior (dev skips the
      # ``==<version>`` pin because the editable install in /src already
      # satisfies it).
      CREMIND_UPGRADE_CHANNEL: ${CREMIND_UPGRADE_CHANNEL:-}
      # Where the in-container Setup Wizard finds the compose file
      # and ``.env`` to drive ``docker compose up -d`` for sidecar
      # services. The host directory is bind-mounted as
      # /opt/cremind-compose below.
      CREMIND_COMPOSE_FILE: /opt/cremind-compose/docker-compose.yml
      CREMIND_COMPOSE_ENV_FILE: /opt/cremind-compose/.env
      # >>> desktop-only >>>
      VNC_PASSWORD: ${VNC_PASSWORD}
      RESOLUTION: ${RESOLUTION:-1280x720}
      # <<< desktop-only <<<
    volumes:
      # Cremind System Directory lives in a named Docker volume, isolated
      # from the host filesystem. Storage, tokens, profile dirs, .env,
      # bootstrap.toml are all written inside the volume — the host's
      # ~/.cremind is untouched by Docker installs. Survives ``docker
      # compose down``; wiped by ``docker compose down -v`` (purge
      # uninstall) along with the other named volumes. Inspect with:
      #   docker run --rm -v cremind_cremind-data:/data busybox ls /data
      - cremind-data:/root/.cremind
      # TLS certificates, when you bring your own. Read-only, and pointed at
      # by CREMIND_SSL_CERTFILE / CREMIND_SSL_KEYFILE using their /certs
      # paths. Not needed for CREMIND_SSL=auto / after-setup, which generate
      # into the cremind-data volume above.
      # - ./certs:/certs:ro
      # The runtime venv lives in a named volume so wizard-installed
      # extras (sentence-transformers, qdrant-client, anthropic, ...)
      # persist across ``docker compose down && up``. The entrypoint
      # seeds this from /opt/cremind-baseline/venv (baked into the
      # image) on first boot.
      - cremind-venv:/opt/cremind/venv
      # The compose project directory itself, mounted read-write so the
      # provisioner can append to COMPOSE_PROFILES + write per-service
      # env vars (Postgres credentials, …) in ``.env``.
      - ./:/opt/cremind-compose
      # Docker socket: lets the in-container backend run
      # ``docker compose up -d <service>`` against the host daemon
      # when the wizard picks Docker mode for a sidecar service. This
      # is a privileged capability — anyone with shell access to the
      # cremind container can drive the host's Docker.
      - /var/run/docker.sock:/var/run/docker.sock
    restart: unless-stopped

  postgres:
    profiles: ["with-postgres"]
    image: postgres:16
    environment:
      POSTGRES_DB: ${PG_DATABASE:-cremind}
      POSTGRES_USER: ${PG_USER:-cremind}
      # Set by the Setup Wizard's Docker provisioner when the user picks
      # Database = Postgres / Docker. Empty means the service is defined
      # but not activated.
      POSTGRES_PASSWORD: ${PG_PASSWORD:-}
    volumes:
      - pg-data:/var/lib/postgresql/data
    healthcheck:
      # ``pg_isready`` returns 0 once Postgres is accepting connections;
      # the wizard's provisioner polls the TCP port directly (matches
      # this readiness semantically and doesn't depend on the
      # ``$$POSTGRES_USER`` env-var escape working under every docker
      # CLI version).
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
    restart: unless-stopped

  qdrant:
    profiles: ["with-qdrant"]
    image: qdrant/qdrant:latest
    volumes:
      - qdrant-data:/qdrant/storage
    restart: unless-stopped

  chroma:
    profiles: ["with-chroma"]
    image: chromadb/chroma:latest
    volumes:
      - chroma-data:/chroma/chroma
    restart: unless-stopped

volumes:
  # cremind-data holds the Cremind System Directory contents (storage/,
  # tokens/, profile dirs, .env, bootstrap.toml). Sidecar service volumes
  # and the runtime venv are named volumes too — nothing on the host
  # needs to inspect any of them directly.
  cremind-data:
  cremind-venv:
  pg-data:
  qdrant-data:
  chroma-data:
