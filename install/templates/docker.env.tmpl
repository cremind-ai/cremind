# Cremind Docker bundle — runtime configuration.
#
# Generated by install.sh / install.ps1; values picked at install time
# end up here, and Compose substitutes them into docker-compose.yml.
#
# Treat this file like a credential store: VNC_PASSWORD is auto-
# generated to ~24 random characters at install time; Postgres
# credentials are added on demand by the Setup Wizard when the user
# picks Database = Postgres / Docker.

# ── Image / build ──────────────────────────────────────────────────────────
# Docker Hub repository for the cremind service. Chosen at install time
# from the "Install the VNC Desktop UI?" answer:
#   cremind/cremind-desktop → XFCE + VNC desktop (default)
#   cremind/cremind         → headless basic image (--no-desktop)
CREMIND_IMAGE=__CREMIND_IMAGE__
# Image tag pulled from Docker Hub at install time. Resolved by
# install.sh / install.ps1 against PyPI (production) or Test PyPI
# (test). Dev installs override this with a local build via
# docker-compose.override.yml.
CREMIND_VERSION=__CREMIND_VERSION__

# ── App-level config ───────────────────────────────────────────────────────
# APP_URL is the canonical externally-reachable backend URL the agent
# advertises in its A2A agent card. CORS controls which UI origins the
# backend trusts. Both are filled by the installer based on the
# deployment-type answer (local vs server).
APP_URL=__APP_URL__
CORS_ALLOWED_ORIGINS=__CORS_ALLOWED_ORIGINS__
SETUP_WIZARD_ENV=__SETUP_WIZARD_ENV__

# HTTPS for the SPA port, which also enables HTTP/2 (the UI holds many
# long-lived SSE streams, and HTTP/1.1 caps a browser at ~6 per origin).
#
# The installer appends the resolved `CREMIND_SSL=` at the END of this file
# from its --ssl flag (default `after-setup`; `--ssl none` for plain HTTP), so
# that line — not the commented examples below — is what compose interpolates.
# Change it there and `docker compose up -d` to apply; the examples are here to
# document the alternatives.
#
# These paths are CONTAINER-side: mount your certificate directory into the
# container first — see the tls volume comment in docker-compose.yml — then
# point these at the mounted paths and make APP_URL https:// to match.
# CREMIND_SSL_CERTFILE=/certs/fullchain.pem
# CREMIND_SSL_KEYFILE=/certs/privkey.pem
#
# Or generate one signed by a local CA, kept in the cremind-home volume at
# ~/.cremind/tls/. Every device that connects must trust its ca.pem once: the
# CA is inside the container, so download it from the running server at
# <origin>/ca.pem (or `docker compose exec cremind cremind tls export --out -`)
# and trust it with `cremind tls trust --file <download>`.
# CREMIND_SSL=auto
#
# Or defer that switch by one phase. `after-setup` generates the same CA at the
# first boot but keeps serving plain HTTP while the Setup Wizard runs, so the
# wizard can walk you through trusting the CA before any https page exists;
# finishing setup restarts the container into https, to a browser that already
# trusts it — no warning, ever. Prefer it to `auto` when a person will open the
# wizard in a browser. APP_URL above still takes the https:// steady state.
# CREMIND_SSL=after-setup

# How Cremind itself was installed. Drives the Setup Wizard's per-service
# deployment-mode filter (see install_catalog.toml's [mode_rules]).
INSTALL_MODE=__INSTALL_MODE__

# ── Ports (host side) ──────────────────────────────────────────────────────
# Edit if a host port is already in use. The container-side ports are
# fixed; only the host mappings are configurable.
API_PORT=1112
SPA_PORT=1515
# Callback port for "Sign in with ChatGPT" (Codex OAuth), published on
# 127.0.0.1 only. Unlike the ports above this one is NOT freely
# reassignable: OpenAI hard-codes the redirect to localhost:1455, so any
# other value simply turns off automatic capture and sign-in falls back to
# pasting the redirect URL. Change it only to free up host port 1455.
CODEX_CALLBACK_PORT=1455
# >>> desktop-only >>>
NOVNC_PORT=6080
VNC_PORT=5900
# <<< desktop-only <<<

# ── Compose project ────────────────────────────────────────────────────────
# Pinned so ``docker compose`` invocations from the host and from
# inside the cremind container address the same project (and therefore
# the same named volumes). Default compose project naming uses the
# parent directory name, which would diverge between host (``docker``)
# and container (``cremind-compose``).
COMPOSE_PROJECT_NAME=cremind

# ── Service activation ─────────────────────────────────────────────────────
# Starts empty — the Setup Wizard appends entries as the user picks
# Docker-mode services. Possible values (comma-separated):
#   with-postgres   → postgres sibling container
#   with-qdrant     → qdrant sibling container
#   with-chroma     → chromadb sibling container
COMPOSE_PROFILES=

# ── Desktop ────────────────────────────────────────────────────────────────
# Present only for the desktop image (cremind/cremind-desktop). The basic
# image's entrypoint ignores these, and the installer strips this block for
# --no-desktop installs.
# >>> desktop-only >>>
# Set on first install; copied to your clipboard then. To rotate, edit
# this value and run ``docker compose up -d``.
VNC_PASSWORD=__VNC_PASSWORD__

# Higher resolutions cost more bandwidth and CPU; 1280x720 is the
# comfort default. Common choices: 1280x720, 1440x900, 1920x1080, 2560x1440.
RESOLUTION=1280x720
# <<< desktop-only <<<
