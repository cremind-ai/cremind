# Cremind backend — custom deployment.
# Generated by install.sh / install.ps1 from the answers you gave to
# the "advanced" prompts. Edit if you need to tune anything afterwards.
#
# `custom` is intentionally permissive — it doesn't pick a HOST / APP_URL
# / CORS shape for you, the way `local` and `server` do. The defaults
# fit a containerized install (bind 0.0.0.0, browse from the docker
# host), but any of the four values below can be overridden via flags
# (--listen-host / --public-url / --allowed-origins / --wizard-preset)
# or by editing this file.

# Server Configuration
ENV=custom
HOST=__LISTEN_HOST__
PORT=1112
APP_URL=__PUBLIC_URL__
DEBUG=true
LOG_LEVEL=INFO
DISABLE_LOG=false

# CORS — origins allowed to call the API. The installer fills in the
# public URL plus the localhost SPA listener when the user leaves the
# prompt blank.
CORS_ALLOWED_ORIGINS=__CORS_ALLOWED_ORIGINS__

# HTTPS for the public origin (1515), which also switches it to HTTP/2 — the
# UI holds many long-lived SSE streams, and HTTP/1.1 caps a browser at ~6
# connections per origin. The internal API port stays plain HTTP.
# Supply your own PEM pair, or generate one signed by a local CA in
# ~/.cremind/tls/ (browsers warn until that ca.pem is trusted per device —
# run `cremind tls trust` here, or download <origin>/ca.pem on another device
# and run `cremind tls trust --file <download>`). Remember to make APP_URL and
# CORS_ALLOWED_ORIGINS https:// to match. Leave unset if a proxy in front of
# this server already terminates TLS.
# CREMIND_SSL_CERTFILE=
# CREMIND_SSL_KEYFILE=
# CREMIND_SSL=auto

# Setup wizard preset
SETUP_WIZARD_ENV=__SETUP_WIZARD_ENV__
