# Cremind backend — server deployment.
# Generated by install.sh / install.ps1 with __APP_HOST__ replaced by the
# IP or domain you provided at install time.

# Server Configuration
ENV=production
HOST=0.0.0.0
PORT=1112
APP_URL=http://__APP_HOST__:1515
DEBUG=false
LOG_LEVEL=INFO
DISABLE_LOG=false

# CORS — allow both the public host and localhost so the UI works
# whether you open it locally or remotely.
CORS_ALLOWED_ORIGINS=http://__APP_HOST__:1515,http://localhost:1515

# HTTPS for the public origin (port 1515), which also enables HTTP/2 — worth
# doing here, because the UI holds many long-lived SSE streams and HTTP/1.1
# caps a browser at ~6 connections per origin. The internal API port stays
# plain HTTP; the CLI and skills reach it over loopback only.
#
# Uncomment ONE of the two, then change APP_URL and CORS_ALLOWED_ORIGINS above
# from http:// to https:// to match.
#
# 1. Your own certificate (from a CA, so no browser warning):
# CREMIND_SSL_CERTFILE=/etc/cremind/tls/fullchain.pem
# CREMIND_SSL_KEYFILE=/etc/cremind/tls/privkey.pem
#
# 2. Generated and signed by a local CA kept in ~/.cremind/tls/. Every device
#    that connects must trust ca.pem once, or it will warn. On this machine:
#    `cremind tls trust`. Elsewhere: download https://__APP_HOST__:1515/ca.pem
#    and run `cremind tls trust --file <download>`.
# CREMIND_SSL=auto
# CREMIND_SSL_AUTO_HOSTS=__APP_HOST__
#
# If a reverse proxy or Ingress already terminates TLS in front of this server,
# leave both unset — it should keep doing that, and this stays plain HTTP.

# Setup wizard preset
SETUP_WIZARD_ENV=server

# INSTALL_MODE (docker / native) is stamped here by the installer
# after this template is rendered. The backend reads it to filter
# service deployment-mode options in the Setup Wizard.
