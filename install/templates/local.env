# Cremind backend — local (loopback) deployment.
# Generated by install.sh / install.ps1. Edit if you need to override anything.

# Server Configuration
ENV=local
HOST=127.0.0.1
PORT=1112
APP_URL=http://localhost:1515
DEBUG=true
LOG_LEVEL=INFO
DISABLE_LOG=false

# CORS — only the loopback UI origin
CORS_ALLOWED_ORIGINS=http://localhost:1515,http://127.0.0.1:1515

# HTTPS. The installer writes CREMIND_SSL for you from its --ssl flag and
# rewrites the two URLs above to https:// to match, so this file normally
# arrives with `CREMIND_SSL=after-setup` appended at the end (install with
# `--ssl none` for plain HTTP).
#
# `after-setup` is plain HTTP while the Setup Wizard runs — the CA is generated
# at the first boot anyway, so the wizard walks you through trusting it — then
# a restart into https, so the first https load never warns. `auto` is https
# from boot one (the wizard itself sits behind the untrusted certificate), and
# CREMIND_SSL_CERTFILE/CREMIND_SSL_KEYFILE take a certificate of your own.
# To change your mind later, edit the appended CREMIND_SSL line, put APP_URL
# and CORS_ALLOWED_ORIGINS above on the matching scheme, and restart.
# See the HTTPS section in CONTRIBUTING.md.

# Setup wizard preset
SETUP_WIZARD_ENV=local

# INSTALL_MODE (docker / native) is stamped here by the installer
# after this template is rendered. The backend reads it to filter
# service deployment-mode options in the Setup Wizard.
