# Cremind backend — local (loopback) deployment.
# Generated by install.sh / install.ps1. Edit if you need to override anything.

# Server Configuration
ENV=local
HOST=127.0.0.1
PORT=1112
APP_URL=http://localhost:1515
DEBUG=true
LOG_LEVEL=INFO
DISABLE_LOG=false

# CORS — only the loopback UI origin
CORS_ALLOWED_ORIGINS=http://localhost:1515,http://127.0.0.1:1515

# HTTPS is available here too (CREMIND_SSL=auto, or your own cert/key via
# CREMIND_SSL_CERTFILE/CREMIND_SSL_KEYFILE), but a loopback-only install has
# little to gain from it — see the HTTPS section in CONTRIBUTING.md.
# A third value, CREMIND_SSL=after-setup, is `auto` with the switch deferred:
# plain HTTP while the Setup Wizard runs (the CA is generated at the first boot
# anyway, so the wizard walks you through trusting it), then a restart into
# https — the first https load never warns. Set APP_URL and
# CORS_ALLOWED_ORIGINS above to https:// (the steady state) if you use either.

# Setup wizard preset
SETUP_WIZARD_ENV=local

# INSTALL_MODE (docker / native) is stamped here by the installer
# after this template is rendered. The backend reads it to filter
# service deployment-mode options in the Setup Wizard.
